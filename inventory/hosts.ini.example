[kube_control_plane]
master-1 ansible_host=10.0.0.10

[kube_node]
worker-1 ansible_host=10.0.0.20
worker-2 ansible_host=10.0.0.21

[k8s_cluster:children]
kube_control_plane
kube_node

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3